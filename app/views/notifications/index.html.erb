<%# Esta tela segue o mockup em Inter (o resto do app usa Poppins) %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<% end %>

<% received = @notifications.to_a %>
<% sent     = @my_likes.to_a %>

<div class="likes-screen-wrapper" data-controller="likes-tabs">
  <div class="likes-column">

    <%# --- 1. HEADER --- %>
    <header class="likes-header">
      <div class="likes-header-text">
        <h1 class="likes-title">Curtidas</h1>
        <p class="likes-subtitle" data-likes-tabs-target="subtitle">Pessoas por perto que curtiram você</p>
      </div>

      <%= link_to safety_center_path, class: "likes-safety-btn" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="M12 8v4M12 16h.01"/>
        </svg>
        <span>Segurança</span>
      <% end %>
    </header>

    <%# --- 2. ABAS (likes_tabs_controller.js) --- %>
    <div class="likes-tabs" role="tablist">
      <button type="button" class="likes-tab is-active" role="tab" aria-selected="true"
              data-likes-tabs-target="tab" data-action="likes-tabs#select"
              data-panel="received" data-subtitle="Pessoas por perto que curtiram você">
        Te curtiram
        <% if received.any? %><span class="likes-tab-count"><%= received.size %></span><% end %>
      </button>
      <button type="button" class="likes-tab" role="tab" aria-selected="false"
              data-likes-tabs-target="tab" data-action="likes-tabs#select"
              data-panel="sent" data-subtitle="Pessoas que você curtiu">
        Você curtiu
      </button>
    </div>

    <%# ========================================================= %>
    <%# QUEM TE CURTIU %>
    <%# ========================================================= %>
    <section class="likes-panel" data-likes-tabs-target="panel" data-panel="received">
      <% if received.any? %>
        <div class="likes-grid">
          <% received.each do |notification| %>
            <%= render "notification", notification: notification %>
          <% end %>
        </div>
      <% else %>
        <%= render "empty_state",
                   title: "Ninguém te curtiu ainda",
                   text: "Quando alguém curtir você, a pessoa aparece aqui na hora." %>
      <% end %>
    </section>

    <%# ========================================================= %>
    <%# QUEM VOCÊ CURTIU %>
    <%# ========================================================= %>
    <section class="likes-panel" data-likes-tabs-target="panel" data-panel="sent" hidden>
      <% if sent.any? %>
        <div class="likes-grid">
          <% sent.each do |like| %>
            <% target_user = like.liked %>
            <%# Verifica se o usuário atual tem permissão para ver quem ele curtiu %>
            <% is_locked = !current_user.can_see_who_i_liked? %>

            <% if target_user %>
              <div class="like-card <%= 'locked' if is_locked %>">
                <%# Destino: Plano (se bloqueado) ou Perfil (se liberado) %>
                <% link_target = is_locked ? plans_path : user_path(target_user) %>

                <%= link_to link_target, class: "like-card-link #{'trigger-upgrade-modal' if is_locked}" do %>
                  <%= image_tag target_user.avatar_url, class: "like-card-img" %>

                  <% if is_locked %>
                    <div class="locked-overlay">
                      <div class="locked-icon">🔒</div>
                      <div class="locked-text">Upgrade</div>
                    </div>
                  <% else %>
                    <div class="like-card-gradient"></div>

                    <div class="like-card-info">
                      <div class="user-details">
                        <span class="name"><%= target_user.display_name.split.first %></span>
                        <span class="age"><%= target_user.age rescue "" %></span>
                      </div>
                      <div class="distance-info">
                        Enviado <%= time_ago_in_words(like.created_at) %> atrás
                      </div>
                    </div>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <%= render "empty_state",
                   title: "Você ainda não curtiu ninguém",
                   text: "Explore quem está por perto e curta quem chamar a sua atenção." %>
      <% end %>
    </section>

  </div>
</div>
