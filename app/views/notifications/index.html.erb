<%# Esta tela segue o mockup em Inter (o resto do app usa Poppins) %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<% end %>

<% received = @notifications.to_a %>
<% sent     = @my_likes.to_a %>

<div class="likes-screen-wrapper" data-controller="likes-tabs">
  <div class="likes-column">

    <%# --- 1. HEADER --- %>
    <header class="likes-header">
      <div class="likes-header-text">
        <h1 class="likes-title">Curtidas</h1>
        <p class="likes-subtitle" data-likes-tabs-target="subtitle">Pessoas por perto que curtiram você</p>
      </div>

      <%= link_to safety_center_path, class: "likes-safety-btn" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="M12 8v4M12 16h.01"/>
        </svg>
        <span>Segurança</span>
      <% end %>
    </header>

    <%# --- 2. ABAS (likes_tabs_controller.js) --- %>
    <div class="likes-tabs" role="tablist">
      <button type="button" class="likes-tab is-active" role="tab" aria-selected="true"
              data-likes-tabs-target="tab" data-action="likes-tabs#select"
              data-panel="received" data-subtitle="Pessoas por perto que curtiram você">
        Te curtiram
        <% if received.any? %><span class="likes-tab-count"><%= received.size %></span><% end %>
      </button>
      <button type="button" class="likes-tab" role="tab" aria-selected="false"
              data-likes-tabs-target="tab" data-action="likes-tabs#select"
              data-panel="sent" data-subtitle="Pessoas que você curtiu">
        Você curtiu
      </button>
    </div>

    <%# ========================================================= %>
    <%# QUEM TE CURTIU %>
    <%# ========================================================= %>
    <section class="likes-panel" data-likes-tabs-target="panel" data-panel="received">
      <% if received.any? %>
        <%# --- Novas hoje: quem curtiu desde a meia-noite (fuso do app) --- %>
        <% locked_received = !current_user.can_see_who_liked_me? %>
        <% today = received.select { |n| n.created_at >= Time.zone.now.beginning_of_day } %>
        <% if today.any? %>
          <div class="likes-today">
            <div class="likes-today-head">
              <h2 class="likes-today-title">Novas hoje</h2>
              <span class="likes-today-count"><%= today.size %> <%= today.size == 1 ? "nova" : "novas" %></span>
            </div>
            <div class="likes-today-row">
              <% today.each do |notification| %>
                <% person = notification.actor %>
                <%# Plano que não mostra quem curtiu: avatar borrado e sem nome %>
                <%= link_to (locked_received ? plans_path : user_path(person)), class: ["likes-today-item", ("locked" if locked_received)] do %>
                  <span class="likes-today-ring"><%= image_tag person.avatar_url, alt: "" %></span>
                  <span class="likes-today-name"><%= locked_received ? "Alguém" : person.display_name.split.first %></span>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

        <div class="likes-grid">
          <% received.each do |notification| %>
            <%= render "notification",
                       notification: notification,
                       liked_back: @liked_back_ids.include?(notification.actor_id),
                       match: @matches_by_user[notification.actor_id] %>
          <% end %>
        </div>
      <% else %>
        <%= render "empty_state",
                   title: "Ninguém te curtiu ainda",
                   text: "Quando alguém curtir você, a pessoa aparece aqui na hora." %>
      <% end %>
    </section>

    <%# ========================================================= %>
    <%# QUEM VOCÊ CURTIU %>
    <%# ========================================================= %>
    <section class="likes-panel" data-likes-tabs-target="panel" data-panel="sent" hidden>
      <% if sent.any? %>
        <div class="likes-grid">
          <% sent.each do |like| %>
            <% target_user = like.liked %>
            <% next unless target_user %>
            <%# Plano que não mostra quem você curtiu: foto borrada, sem nome, link para os planos %>
            <% is_locked = !current_user.can_see_who_i_liked? %>
            <% first_name = target_user.display_name.split.first %>

            <div class="like-card <%= 'locked' if is_locked %>">
              <%= image_tag target_user.avatar_url, class: "like-card-img", alt: "" %>
              <div class="like-card-gradient"></div>

              <div class="like-card-info like-card-info--wide">
                <% if is_locked %>
                  <p class="like-card-name"><strong>Curtida enviada</strong></p>
                  <p class="like-card-meta">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                    Ver quem você curtiu
                  </p>
                <% else %>
                  <p class="like-card-name"><strong><%= first_name %></strong> <%= target_user.age %></p>
                  <p class="like-card-meta">Enviado <%= time_ago_in_words(like.created_at) %> atrás</p>
                <% end %>
              </div>

              <%= link_to (is_locked ? plans_path : user_path(target_user)), class: "like-card-link",
                          aria: { label: is_locked ? "Ver planos para descobrir quem você curtiu" : "Ver perfil de #{first_name}" } do %><% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <%= render "empty_state",
                   title: "Você ainda não curtiu ninguém",
                   text: "Explore quem está por perto e curta quem chamar a sua atenção." %>
      <% end %>
    </section>

  </div>
</div>

<%# Modal de limite de curtidas: LikesController responde com turbo_stream.update aqui %>
<div id="upgrade-modal-container" style="position: relative; z-index: 99999;"></div>
