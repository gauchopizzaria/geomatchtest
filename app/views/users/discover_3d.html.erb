<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-preview">
<% end %>
<style>
  #map-3d { opacity: 1; }
</style>

<div id="assets-data"
     data-frame-url="<%= image_path('aurea-dourada-mensagens.svg') %>"
     data-verified-url="<%= image_path('icone-verificar.png') %>"
     style="display: none;"></div>

<div id="current-user-data" data-invisible="<%= current_user.invisible %>"></div>

<div class="discover-fullscreen-container">

  <%#
    data-user-lat / data-user-lng: coords do banco (Prioridade 2 na hierarquia de localização).
    Usadas quando o GPS é negado, demora ou o usuário não tem geolocation.
    to_f garante que nil vira 0.0 — o JS checa por valores válidos antes de usar.
  %>
  <div class="map-wrapper" data-controller="map-loader" style="position: relative; width: 100%; height: 100vh;">
    <%= render "shared/map_loading" %>
    <div id="map-3d" class="map-fullscreen"
         data-user-lat="<%= current_user.latitude.to_f %>"
         data-user-lng="<%= current_user.longitude.to_f %>"
         data-map-loader-target="map"></div>
  </div>

  <div class="discover-header-floating">
    <div class="header-left">
      <%= image_tag "logo-geomatch-dourada.png", class: "header-logo-img" %>
    </div>
    <div class="header-right">
      <%= render "gender_filter", selected: "all" %>
    </div>
  </div>

  <div class="radar-control-floating">
    <div class="radar-badge-box">
      <%= image_tag "icone-300m.png", class: "radar-badge-img" %>
      <span id="range-value-text" class="dynamic-value-text">150m</span>
    </div>
    
    <div class="slider-track-container">
      <%= image_tag "icone-raio.png", class: "slider-track-bg" %>
      <input type="range" id="radar-range" min="1" max="300" value="150" step="1" class="range-slider-custom">
    </div>
  </div>

  <div class="map-fab-container">
    <button class="fab-button" id="fab-live-tracking" title="Seguir em Tempo Real">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
      </svg>
    </button>

    <button id="toggle-visibility-btn" class="fab-button fab-visibility" title="Modo Invisível">
      <svg class="eye-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
      <svg class="eye-closed hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
        <line x1="1" y1="1" x2="23" y2="23"></line>
      </svg>
    </button>

    <button class="fab-button" id="fab-center-map" title="Centralizar no meu local">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="1"></circle>
        <path d="M12 8v-2"></path>
        <path d="M12 18v2"></path>
        <path d="M8 12H6"></path>
        <path d="M18 12h2"></path>
      </svg>
    </button>

    <%= link_to discover_3d_gallery_path,
        class: "fab-button fab-gallery",
        title: "Busca por cidade",
        style: "background: linear-gradient(135deg,#d4be91,#b8975a); color:#1a1a1a; box-shadow: 0 4px 15px rgba(180,140,70,0.45);" do %>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3"  y="3"  width="7" height="7" rx="1.5"></rect>
        <rect x="14" y="3"  width="7" height="7" rx="1.5"></rect>
        <rect x="3"  y="14" width="7" height="7" rx="1.5"></rect>
        <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
      </svg>
    <% end %>
  </div>

  <div class="users-bottom-sheet">
    <div class="bottom-sheet-handle"><div class="handle-bar"></div></div>
    
    <div class="bottom-sheet-content">
      <div class="bottom-sheet-header">
        <div class="header-users-title">
           <%= image_tag "icone-usuarios-proximos.png", class: "icon-users-header" %>
           <%= image_tag "texto-usuarios-proximos.png", class: "text-users-header" %>
        </div>
        <span class="nearby-count" id="nearby-count">0</span>
      </div>
      
      <ul id="users-list" class="users-list-fullscreen">
        <li class="text-center loading-text">Buscando...</li>
      </ul>
    </div>
  </div>

  <%# --- POPUP DE USUÁRIO CORRIGIDO --- %>
  <div id="user-popup" class="user-popup-fullscreen hidden">
    <div class="popup-overlay"></div>
    
    <div class="popup-content-fullscreen dsc-sheet" id="draggable-popup">
      
      <div class="dsc-drag-handle-area">
        <div class="dsc-handle-bar"></div>
      </div>

      <button id="close-popup-btn" class="dsc-close-btn">
        <i class="fas fa-arrow-down"></i>
      </button>

      <%# CONTEÚDO SCROLLÁVEL %>
      <div class="dsc-scroll-content">
        
        <%# TOPO: FOTO IMERSIVA — slides injetados via JS %>
        <div class="dsc-carousel-wrapper">
          <div id="popup-carousel" class="dsc-main-carousel"></div>

          <div class="dsc-carousel-indicators" id="popup-carousel-dots"></div>

          <div class="dsc-cover-overlay">
            <div class="dsc-cover-info">
              <h2 class="dsc-cover-name">
                <span id="popup-username"></span><span id="popup-age" class="dsc-cover-age"></span>
                <img id="popup-verified-badge" src="<%= image_path('icone-verificar.png') %>" style="display:none; width:18px; height:18px; flex-shrink:0;" title="Perfil Verificado">
              </h2>
              <p class="dsc-cover-distance">
                <i class="fas fa-location-arrow"></i>
                <span id="popup-distance">0.0 km</span> de distância
              </p>
            </div>
          </div>
        </div>

        <%# ÁREA DOS BOTÕES DE AÇÃO - SEM FAIXA BRANCA %>
        <div class="dsc-action-container">
          
          <%# 1. REJEITAR %>
          <%= button_to reject_user_path(user_id: 0), method: :post, class: "dsc-action-btn btn-reject", form: { id: "popup-reject-form", class: "dsc-action-form", "data-base-action" => reject_user_path(user_id: 0) } do %>
            <%= hidden_field_tag :source, "map" %> 
            <%= image_tag "botao-rejeitar.svg", alt: "Rejeitar" %>
          <% end %>

          <%# 2. CHAT %>
          <%= button_to start_chat_path(user_id: 0), method: :post, class: "dsc-action-btn btn-chat", form: { id: "popup-chat-form", class: "dsc-action-form", "data-base-action" => start_chat_path(user_id: 0) } do %>
            <%= image_tag "mensagem-prata.svg", alt: "Chat" %>
          <% end %>

          <%# 3. LIKE %>
          <%= button_to likes_path(user_id: 0), method: :post, class: "dsc-action-btn btn-like", form: { id: "popup-like-form", class: "dsc-action-form", "data-base-action" => likes_path(user_id: 0) } do %>
            <%= hidden_field_tag :source, "map" %>
            <div class="dsc-heart-icon-wrapper">
              <%= image_tag "coracao-chapada.png", alt: "Curtir" %>
            </div>
          <% end %>

          <%# 4. ENVIAR MIMO — id populado via JS em showUserPopup (map_3d.js),
              mesmo padrão de popup-btn-report/popup-btn-block logo abaixo %>
          <button type="button" id="popup-btn-mimo" class="dsc-action-btn btn-mimo" title="Enviar Mimo">
            <span>🎁</span>
          </button>
        </div>

        <%# DETALHES DO PERFIL %>
        <div class="dsc-body-container">
          <div class="dsc-info-card">
            <h3 class="dsc-card-header">Sobre mim</h3>
            <div class="dsc-card-content-center">
              <p id="popup-bio" class="dsc-bio-text">Sem descrição.</p>
            </div>
          </div>

          <div class="dsc-info-card">
             <h3 class="dsc-card-header">Informações</h3>
             <div class="dsc-basic-list">
                <div class="dsc-basic-item">
                    <span class="dsc-basic-icon"><i class="fas fa-venus-mars"></i></span>
                    <span id="popup-gender" class="dsc-basic-text"></span>
                </div>
                <div class="dsc-basic-item">
                    <span class="dsc-basic-icon"><i class="fas fa-search"></i></span>
                    <span id="popup-interest" class="dsc-basic-text"></span>
                </div>
                <div class="dsc-basic-item">
                  <span class="dsc-basic-icon"><i class="fas fa-map-marker-alt"></i></span>
                  <span id="popup-location" class="dsc-basic-text"></span>
                </div>
             </div>
          </div>

          <div class="dsc-safety-area">
            <div class="dsc-safety-divider"></div>
            <button id="popup-btn-report" class="dsc-btn-safety">DENUNCIAR USUÁRIO</button>
            <div class="dsc-safety-separator"></div>
            <button id="popup-btn-block" class="dsc-btn-safety">BLOQUEAR USUÁRIO</button>
            <div class="dsc-safety-divider"></div>
          </div>
          
          <div class="dsc-bottom-spacer"></div>
        </div>
      </div>
    </div>
  </div>

  <%# Mini Card fixo — independente da rotação do mapa %>
  <div id="mini-card-overlay" style="display:none; position:fixed; bottom:260px; left:50%; transform:translateX(-50%) translateY(30px); z-index:1000; width:210px; pointer-events:auto; opacity:0; transition:opacity 0.28s ease, transform 0.28s cubic-bezier(0.34,1.56,0.64,1);">
    <div style="border-radius:20px; overflow:hidden; position:relative; height:260px; box-shadow:0 8px 32px rgba(0,0,0,0.45);">
      <img id="mco-avatar" src="" alt="" style="width:100%; height:100%; object-fit:cover; object-position:center 20%; display:block;">
      <div style="position:absolute; bottom:0; left:0; right:0; height:60%; background:linear-gradient(to top, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.38) 60%, transparent 100%); pointer-events:none;"></div>
      <div style="position:absolute; bottom:52px; left:0; right:0; padding:0 14px;">
        <div style="display:flex; align-items:center; gap:5px;">
          <p id="mco-name" style="margin:0; font-weight:700; font-size:1.2rem; color:#fff; letter-spacing:-0.3px; text-shadow:0 1px 4px rgba(0,0,0,0.4);"></p>
          <img id="mco-verified-badge" src="<%= image_path('icone-verificar.png') %>" style="display:none; width:16px; height:16px;" title="Perfil Verificado">
        </div>
        <p id="mco-distance" style="margin:3px 0 0; font-size:0.78rem; color:rgba(255,255,255,0.8);"></p>
      </div>
      <button id="mco-view-btn" style="position:absolute; bottom:12px; left:12px; right:12px; padding:10px 0; background:rgba(255,255,255,0.18); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px); border:1px solid rgba(255,255,255,0.32); border-radius:999px; color:#fff; font-weight:700; font-size:0.85rem; cursor:pointer; letter-spacing:0.3px;">Ver Perfil</button>
    </div>
  </div>

  <div id="upgrade-modal-container" style="position: relative; z-index: 99999;"></div>

  <%# --- GENDER HUD --- %>
  <div id="gender-hud" class="gender-hud">
    <%# Gradient referenced by all JS-injected gender SVG icons %>
    <svg width="0" height="0" style="position:absolute; overflow:hidden;">
      <defs>
        <%# userSpaceOnUse: gradiente em objectBoundingBox não renderiza em linhas
            retas (bbox de área zero) — as hastes dos símbolos ♀/⚥ sumiriam %>
        <linearGradient id="gm-gold-grad" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="24" y2="0">
          <stop offset="0%" stop-color="#F4DFC4"/>
          <stop offset="100%" stop-color="#C9A079"/>
        </linearGradient>
      </defs>
    </svg>
    <div id="gender-hud-icons" class="gender-hud__icons"></div>
    <p id="gender-hud-label" class="gender-hud__label"></p>
  </div>
</div>

<%= javascript_include_tag "live_location", type: "module" %>
<%= javascript_include_tag "map_3d", type: "module" %>
