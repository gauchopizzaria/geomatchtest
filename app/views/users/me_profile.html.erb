<div class="profile-dashboard-wrapper" style="overflow-x: hidden; width: 100%; max-width: 100vw;">
  
  <%# --- 1. HEADER (Apenas o Título) --- %>
  <div class="profile-header-container">
    <div class="header-left">
      <%= image_tag "texto-perfil.png", alt: "Perfil", class: "header-title-sm" %>
    </div>
    <div class="header-right">
      <button class="header-btn"
        data-controller="theme"
        data-action="click->theme#toggle"
        data-theme-sol-icon="<%= asset_path('sol-dourado.svg') %>"
        data-theme-lua-icon="<%= asset_path('lua-dourado.svg') %>">
        <%= image_tag "sol-dourado.svg", alt: "Tema", data: { theme_target: "icon" } %>
      </button>
    </div>
  </div>

  <%# --- 2. HERO SECTION (Avatar | Info | Ajuda) --- %>
  <div class="profile-hero">
    
    <%# ESQUERDA: Avatar %>
    <div class="hero-avatar-container">
      <%= image_tag @user.avatar_url, class: "hero-avatar-img" %>
      <%= image_tag "aurea-dourada-mensagens.svg", class: "hero-ring" %>
    </div>

    <%# CENTRO: Nome e Botão Editar %>
    <div class="hero-info">
      <h2 class="hero-name">
        <%= @user.display_name.split.first %>, <%= @user.age %>
        
        <%# --- LÓGICA: Exibe ícone APENAS se verificado --- %>
        <% if @user&.verified? %>
          <%= image_tag "icone-verificar.png", class: "verified-icon-name", title: "Perfil Verificado" %>
        <% end %>
      </h2>
      
      <%= link_to edit_profile_path, class: "btn-edit-pill" do %>
        <i class="fas fa-pen"></i> Completar perfil
      <% end %>
    </div>

   <%# DIREITA: Botão Ajuda (AGORA COM LINK) %>
    <div class="hero-help">
      <%= link_to safety_center_path, class: "btn-help-png" do %>
        <%= image_tag "botao-ajuda.png", alt: "Ajuda" %>
      <% end %>
      <span class="help-label">Ajuda</span>
    </div>

  </div>

  <%# --- 3. BANNER VERIFICAÇÃO (Lógica condicional por status de moderação) --- %>
  <% if @user&.verified? %>
    <%# Estado 4: Verificado — selo verde %>
    <div class="verification-banner" style="cursor:default;border-color:rgba(34,197,94,.35);background:rgba(34,197,94,.06)">
      <div class="icon-box">
        <%= image_tag "icone-verificar.png", class: "verify-icon-lg" %>
      </div>
      <div class="banner-text">
        <strong style="color:#22c55e">Identidade Verificada!</strong>
        <p class="banner-description">Obrigado por confirmar seu perfil. Seu selo de usuário verificado já está ativo.</p>
        <div class="progress-bar-lines">
          <span class="line full" style="background:#22c55e"></span>
          <span class="line full" style="background:#22c55e"></span>
          <span class="line full" style="background:#22c55e"></span>
        </div>
      </div>
    </div>

  <% elsif @user.ai_moderation_status == 'pending' || @user.ai_moderation_status == 'manual_review' %>
    <%# Estado 2: Em análise — aviso âmbar com ícone de relógio %>
    <div class="verification-banner" style="cursor:default;border-color:rgba(245,158,11,.35);background:rgba(245,158,11,.06)">
      <div class="icon-box">
        <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
        </svg>
      </div>
      <div class="banner-text">
        <strong>Documentos em análise</strong>
        <p class="banner-description">Seus documentos estão sendo validados. Nossa equipe está verificando sua identidade e avisaremos em breve.</p>
      </div>
    </div>

  <% elsif @user.ai_moderation_status == 'rejected' %>
    <%# Estado 3: Recusado — alerta vermelho + botão para reenviar %>
    <%
      rejection_reasons = {
        "no_face_in_selfie"           => "Nenhum rosto foi identificado na selfie.",
        "explicit_content"            => "Uma das imagens contém conteúdo inapropriado.",
        "name_not_found_in_document"  => "Não conseguimos ler o seu nome no documento enviado.",
        "face_mismatch"               => "O rosto da selfie não corresponde ao documento.",
        "api_error"                   => "Ocorreu um erro ao processar os documentos.",
        "no_face_detected"            => "Nenhum rosto foi identificado na foto.",
        "name_not_found_in_photo"     => "Não conseguimos ler o seu nome na imagem."
      }
      raw_reason      = @user.ai_moderation_details&.dig("reason").to_s
      friendly_reason = rejection_reasons.fetch(raw_reason, "Seus documentos não puderam ser aprovados.")
    %>
    <div class="verification-banner" style="cursor:default;flex-direction:column;gap:0.75rem;border-color:rgba(239,68,68,.35);background:rgba(239,68,68,.06)">
      <div style="display:flex;align-items:center;gap:0.875rem;width:100%">
        <div class="icon-box">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#f87171" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
        </div>
        <div class="banner-text">
          <strong style="color:#f87171">Documentos não aprovados</strong>
          <p class="banner-description"><%= friendly_reason %></p>
        </div>
      </div>
      <%= link_to verification_path, style: "display:block;padding:12px 20px;border-radius:50px;background:var(--color-primary);color:#000;font-weight:700;text-align:center;text-decoration:none;font-size:0.9rem;width:100%;box-sizing:border-box" do %>
        Enviar novos documentos
      <% end %>
    </div>

  <% else %>
    <%# Estado 1: Nenhuma foto enviada ainda — banner padrão com link %>
    <%= link_to verification_path, class: "verification-banner" do %>
      <div class="icon-box">
        <%= image_tag "icone-verificar.png", class: "verify-icon-lg" %>
      </div>
      <div class="banner-text">
        <strong>Verifique seu Perfil</strong>
        <p class="banner-description">
          Ajuda a proteger os usuários contra perfis que tentam se passar por outros para enganar as pessoas.
        </p>
        <div class="progress-bar-lines">
          <span class="line full"></span>
          <span class="line full"></span>
          <span class="line"></span>
        </div>
      </div>
      <div class="banner-arrow">›</div>
    <% end %>
  <% end %>

  <%# --- 3.5. CARTEIRA DIGITAL (Mimos) — acesso rápido a saldo e saques ---
      wallet pode ser nil pra quem nunca recebeu um Mimo ainda (has_one, sem
      criação automática) — &. + fallback garantem "R$ 0,00" em vez de erro. %>
  <%= link_to mimo_wallet_page_path, class: "verification-banner" do %>
    <div class="icon-box">
      <span class="wallet-banner-icon">💰</span>
    </div>
    <div class="banner-text">
      <strong>Minha Carteira</strong>
      <p class="banner-description">
        Saldo disponível: <strong class="wallet-banner-balance"><%= @user.wallet&.balance&.format || "R$ 0,00" %></strong>
      </p>
    </div>
    <div class="banner-arrow">›</div>
  <% end %>

  <%# --- 4. SEÇÃO DESTAQUE --- %>
  <div class="highlight-section">
    <div class="highlight-photo">
      <%= image_tag "mao_comprimento.png", class: "photo-cover" %>
    </div>
    
    <div class="highlight-text-content">
      <h3 class="highlight-title">Integração com Eventos</h3>
      <p class="highlight-description">
        Participe de eventos especiais, faça check-in com QR code e descubra pessoas com interesses similares em festivais e encontros.
      </p>
    </div>
  </div>

<%# --- 5. BLOCO UPGRADE (CARROSSEL) --- %>
  <div class="upgrade-carousel-container">
    <div class="upgrade-track">
      <%# Plano Grátis %>
      <%= link_to plans_path, class: "upgrade-card" do %>
        <%= image_tag "bloco-upgrade.png", class: "upgrade-img-responsive" %>
      <% end %>

      <%# Plano Plus %>
      <%= link_to plans_path, class: "upgrade-card" do %>
        <%= image_tag "bloco-upgrade-plus.png", class: "upgrade-img-responsive" %>
      <% end %>

      <%# Plano Gold %>
      <%= link_to plans_path, class: "upgrade-card" do %>
        <%= image_tag "bloco-upgrade-gold.png", class: "upgrade-img-responsive" %>
      <% end %>
    </div>
  </div>

  <%# --- SEÇÃO DE CUPONS --- %>
  <div class="coupon-section" style="margin: 20px 16px 0; padding: 20px; background: var(--color-section-light); border: 1px solid var(--color-border); border-radius: 16px;">
    <h3 style="margin: 0 0 4px; font-size: 1rem; font-weight: 700; color: var(--color-text);">
      <i class="fas fa-ticket-alt" style="color: var(--color-primary); margin-right: 6px;"></i>Aplicar Cupom
    </h3>

    <% if @user.premium? %>
      <p style="margin: 0 0 14px; font-size: 0.8rem; color: var(--color-text-secondary);">
        ✨ Acesso premium ativo até <strong><%= @user.premium_until.strftime('%d/%m/%Y') %></strong>. Um novo cupom soma mais dias.
      </p>
    <% else %>
      <p style="margin: 0 0 14px; font-size: 0.8rem; color: var(--color-text-secondary);">
        Tem um código promocional? Insira abaixo para desbloquear recursos premium.
      </p>
    <% end %>

    <%= form_with url: apply_coupon_path, method: :post do |form| %>
      <div style="display: flex; gap: 10px; align-items: stretch;">
        <%= form.text_field :coupon_code,
              placeholder: "Insira seu código",
              autocomplete: "off",
              style: "flex: 1; min-width: 0; padding: 12px 15px; border: 1px solid var(--color-border); border-radius: 12px; background: var(--color-input-bg); color: var(--color-text); font-size: 0.9rem; outline: none; text-transform: uppercase;" %>
        <%= form.submit "Aplicar",
              style: "padding: 12px 20px; border: none; border-radius: 12px; background: var(--color-primary); color: #121212; font-weight: 700; font-size: 0.9rem; cursor: pointer; flex-shrink: 0;" %>
      </div>
    <% end %>
  </div>

</div> <%# fecha o upgrade-carousel-container %>

  <%# --- 6. AÇÕES DA CONTA (SAIR / EXCLUIR) --- %>
  <div class="profile-account-actions">

    <%# Botão Sair - Abre o modal %>
    <button type="button" class="btn-logout" onclick="document.getElementById('logout-modal').classList.add('show')" style="border: none; background: transparent; width: 100%;">
      <i class="fas fa-sign-out-alt"></i> Sair
    </button>

    <%# Botão Encerrar Conta %>
    <%= button_to user_registration_path, method: :delete, data: { turbo_confirm: "Tem certeza que deseja excluir sua conta? Essa ação não pode ser desfeita." }, class: "btn-delete-account" do %>
      Encerrar minha conta
    <% end %>

  </div>

</div> <%# fecha o profile-dashboard-wrapper %>

<%# --- MODAL DE CONFIRMAÇÃO DE LOGOUT --- %>
<div id="logout-modal" class="logout-modal-overlay">
  <div class="logout-modal-content">

    <div class="logout-icon">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
        <polyline points="16 17 21 12 16 7"></polyline>
        <line x1="21" y1="12" x2="9" y2="12"></line>
      </svg>
    </div>

    <h3>Sair do GeoMatch?</h3>
    <p>Tem certeza que deseja sair do app GeoMatch?</p>

    <div class="logout-actions">
      <%# BOTÃO NÃO: Apenas fecha o modal %>
      <button type="button" class="btn-cancel" onclick="document.getElementById('logout-modal').classList.remove('show')">
        Não
      </button>

      <%# BOTÃO SIM: Realiza o Logout de verdade %>
      <button type="button" class="btn-confirm" onclick="confirmLogout()">
        Sim
      </button>
    </div>

  </div>
</div>

<script>
  function confirmLogout() {
    fetch('<%= destroy_user_session_path %>', {
      method: 'DELETE',
      headers: {
        'X-CSRF-Token': '<%= form_authenticity_token %>',
        'Content-Type': 'application/json'
      }
    })
    .then(response => {
      if (response.ok) {
        window.location.reload();
      }
    })
    .catch(error => console.error('Erro ao fazer logout:', error));
  }
</script>