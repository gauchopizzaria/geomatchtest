<div class="gm-mimo-wrapper"
     data-controller="wallet"
     data-wallet-show-url-value="<%= wallet_path %>"
     data-wallet-withdraw-url-value="<%= withdraw_wallet_path %>"
     data-wallet-wallet-page-url-value="<%= mimo_wallet_page_path %>">

  <div class="gm-mimo-appbar">
    <%= link_to mimo_wallet_page_path, class: "gm-mimo-back" do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
    <% end %>
    <h1>Sacar para Pix</h1>
    <span class="gm-mimo-appbar-spacer"></span>
  </div>

  <div class="gm-saque-body">
    <div>
      <label class="gm-saque-label" for="saque-amount">Valor a sacar</label>
      <input id="saque-amount" class="gm-saque-input" data-wallet-target="amountInput" inputmode="numeric" placeholder="R$ 0,00">
      <div class="gm-saque-avail">Saldo disponível: <span data-wallet-target="availableText">—</span></div>
    </div>

    <div>
      <span class="gm-saque-label">Tipo de chave Pix</span>
      <div class="gm-saque-key-list" data-wallet-target="keyOptions">
        <% [["cpf", "CPF"], ["email", "E-mail"], ["phone", "Telefone"], ["random", "Chave aleatória"]].each do |value, label| %>
          <button type="button" class="gm-saque-key-opt" data-key-type="<%= value %>" data-action="wallet#selectKeyType">
            <span class="gm-saque-key-dot"></span><%= label %>
          </button>
        <% end %>
      </div>
      <input class="gm-saque-key-input" data-wallet-target="keyInput" style="margin-top:10px" placeholder="Digite sua chave Pix">
    </div>

    <div class="gm-mimo-error-banner" data-wallet-target="error"></div>

    <%# Lê a constante do serviço para o texto nunca divergir da regra aplicada. %>
    <div class="gm-saque-aviso">Valor mínimo para saque: <strong><%= Money.new(WithdrawalService::MINIMUM_AMOUNT_CENTS, "BRL").format %></strong>. O processamento pode levar até 1 dia útil.</div>

    <button type="button" class="gm-mimo-btn gm-mimo-btn--gold" data-wallet-target="withdrawButton" data-action="wallet#withdraw">
      <span class="gm-mimo-spinner"></span>
      <span class="gm-mimo-btn-label">Confirmar Saque</span>
    </button>
  </div>
</div>
